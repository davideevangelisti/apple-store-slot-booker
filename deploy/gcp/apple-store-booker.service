[Unit]
Description=Apple Store Saturday slot watcher and auto-booker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=applebooker
Group=applebooker
WorkingDirectory=/opt/apple-store-booker
Environment=NODE_ENV=production
EnvironmentFile=/etc/apple-store-booker/app.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/apple-store-booker

[Install]
WantedBy=multi-user.target
