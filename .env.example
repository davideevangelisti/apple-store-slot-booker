PORT=3000
HOST=127.0.0.1
ALLOWED_HOSTS=

# Public HTTPS base URL that ChatGPT can reach, for example:
# PUBLIC_BASE_URL=https://your-stable-domain.example.com
# PUBLIC_BASE_URL=https://abc123.ngrok.app
PUBLIC_BASE_URL=

# Google OAuth app credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults to PUBLIC_BASE_URL/oauth/google/callback.
# Add this exact URL to your Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=

# Keep the default unless you remove write tools.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send

# MCP scopes issued by this server to ChatGPT.
MCP_SCOPES=gmail.read gmail.draft gmail.modify gmail.send

# Runtime token store. This file contains secrets and is gitignored.
STORE_PATH=data/store.json

# How often the server checks for due MCP-managed Gmail reminders.
REMINDER_CHECK_INTERVAL_SECONDS=60

# Apple Store appointment availability checker.
# Set APPLE_STORE_ENABLED=true and APPLE_STORE_NOTIFY_EMAIL to activate.
# The notify email must be a Google account already connected to this server via OAuth.
APPLE_STORE_ENABLED=false
APPLE_STORE_NOTIFY_EMAIL=
# Defaults: R045 = Apple Rosenstrasse Munich city center
APPLE_STORE_ID=R045
APPLE_STORE_NAME=Apple Rosenstrasse, Munich
APPLE_STORE_ISSUE=AirPods repair (right earbud lower volume)
# Normal polling interval in seconds (default: 30 minutes)
APPLE_STORE_CHECK_INTERVAL_SECONDS=1800
# Faster polling on Saturday mornings 08:00-12:00 Munich time (default: 5 minutes)
APPLE_STORE_SAT_MORNING_INTERVAL_SECONDS=300

# Auto-booking: set APPLE_STORE_AUTO_BOOK=true to automatically book the best Saturday
# morning slot when one is detected, instead of just sending a notification email.
# Requires: npm run setup:chromium (installs the headless Chromium browser).
APPLE_STORE_AUTO_BOOK=false

# Booking customer details (required when APPLE_STORE_AUTO_BOOK=true)
APPLE_BOOKING_FIRST_NAME=
APPLE_BOOKING_LAST_NAME=
APPLE_BOOKING_PHONE=
# Defaults to APPLE_STORE_NOTIFY_EMAIL if not set
APPLE_BOOKING_EMAIL=

# Preferred time slot — tier 1 is highest priority (default: 09:00–09:59 Munich).
# Tier 2: before tier1 start; tier 3: tier1 end → 11:59; tier 4: 12:00+.
APPLE_BOOKING_SLOT_TIER1_START=9
APPLE_BOOKING_SLOT_TIER1_END=10

# Optional: directory for debug screenshots during auto-booking (leave empty to disable)
APPLE_BOOKING_DEBUG_DIR=

# Optional: path to a system Chromium binary (leave empty to use Playwright's bundled Chromium)
CHROMIUM_PATH=
